{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=merstassel.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Jwt": {
    "Issuer": "MersTassel",
    "Audience": "MersTasselClient",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://127.0.0.1:3000" ]
  },
  "App": {
    "ClientUrl": "http://localhost:3000"
  },
  "Storage": {
    "MaxBytes": 10485760
  },
  "Support": {
    "StoragePath": "support-data"
  },
  "ModelGeneration": {
    "StoragePath": "model-data",
    "MeshyBaseUrl": "https://api.meshy.ai/openapi/v1/",
    "MeshyApiKey": "",
    "ProcessorUrl": "",
    "ProcessorKey": ""
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "Currency": "try",
    "FrontendUrl": "http://localhost:3000"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "Username": "",
    "AppPassword": "",
    "Recipient": "merstassel@gmail.com",
    "FromName": "MERS Tassel Website"
  },
  "Seed": {
    "AdminEmail": "admin@merstassel.local",
    "AdminPassword": "",
    "ResetAdminPassword": false
  }
}
