# Local: http://localhost:5080
# Vercel production: https://api.your-domain.example
NEXT_PUBLIC_API_URL=http://localhost:5080
# Optional when an administrator scans a phone-capture QR from a LAN or custom hostname.
# Uncomment and set this to the URL that the phone can open (for example
# http://192.168.1.20:3000), then restart Next.js before creating a new capture link.
# NEXT_PUBLIC_CAPTURE_BASE_URL=http://192.168.1.20:3000
